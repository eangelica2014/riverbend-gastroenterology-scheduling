  classDef paper fill:#FBF8F0,color:#102A24,stroke:#26463E,stroke-width:1px;
  classDef attention fill:#F05A28,color:#FFFFFF,stroke:#BF3D18,stroke-width:2px;
  classDef verified fill:#B9D531,color:#102A24,stroke:#597000,stroke-width:2px;
  class A,B,C,D paper;
  class E,F,G,H ink;
  class B,F attention;
  class D,H verified;
